{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/icons/*.svg",
          "/*.css",
          "/main-*.js"
        ]
      }
    },
    {
      "name": "lazy-features",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/*.js"]
      }
    },
    {
      "name": "localization-catalogs",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/i18n/**/*.json"]
      },
      "cacheQueryOptions": {
        "ignoreSearch": true
      }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/api/**"]
}
