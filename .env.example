# Safe local-development defaults. Never reuse these values in production.
APP_ENV=development
APP_ADDR=:8080
APP_PUBLIC_URL=http://localhost:8080
APP_BRAND_CONFIG=/app/config/brand.json
APP_DEFAULT_LOCALE=en
APP_SUPPORTED_LOCALES=en,ru
DATABASE_URL=postgres://veltrix_app:veltrix_local_password@postgres:5432/veltrix_crm?sslmode=disable
DATABASE_ADMIN_URL=postgres://postgres:postgres_local_password@postgres:5432/veltrix_crm?sslmode=disable
DATABASE_DISPATCHER_URL=postgres://veltrix_dispatcher:veltrix_local_password@postgres:5432/veltrix_crm?sslmode=disable
POSTGRES_DB=veltrix_crm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_password
APP_DB_PASSWORD=veltrix_local_password
AUTO_MIGRATE=true
SESSION_COOKIE_SECURE=false
SESSION_TTL=168h
PASSWORD_RESET_TTL=1h
MFA_CHALLENGE_TTL=5m
MFA_SETUP_TTL=10m
# Development-only AES-256 key (32 zero bytes). Generate a unique key for every production deployment.
IDENTITY_ENCRYPTION_KEY_ID=dev-local-v1
IDENTITY_ENCRYPTION_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SHUTDOWN_TIMEOUT=10s
WORKER_CONCURRENCY=2
MAX_DB_CONNECTIONS=8
UPLOAD_DIR=/var/lib/veltrix-crm/uploads
MAX_UPLOAD_BYTES=10485760
# Keep local for the two-container base profile. Set s3 only with explicit credentials/provider.
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=crm-attachments
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_SESSION_TOKEN=
S3_ALLOW_INSECURE=false
# To use `docker compose --profile mail up`, set SMTP_ADDR=mailpit:1025 and
# SMTP_FROM=noreply@demo.local. Both stay empty in the two-container base profile.
SMTP_ADDR=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=false
SMTP_IMPLICIT_TLS=false
SMTP_WRITE_TIMEOUT=10s
# Optional and disabled by default. Never commit AI_API_KEY.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT=15s
AI_MAX_INPUT_BYTES=32768
AI_MAX_OUTPUT_BYTES=8192
AI_MAX_CONTEXT_ITEMS=50
AI_MAX_DUPLICATE_CANDIDATES=25
AI_MAX_CONCURRENCY=2
AI_REQUESTS_PER_MINUTE=10
# Optional real-time audio/video. For local use, run `docker compose --profile calls up --build`
# and set these development-only values. Production requires WSS, trusted TLS, strong secrets,
# and the documented UDP/TCP firewall/TURN configuration.
CALLS_PROVIDER=disabled
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL=5m
DEMO_SEED=true
DEMO_EMAIL=admin@demo.local
DEMO_PASSWORD=Demo123!
